{
  "extends": "@internal/ts-config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react",
    "types": ["jest", "offscreencanvas", "node"],
    "lib": ["DOM", "ESNext"],
    "baseUrl": "./",
    "rootDir": ".",
    "paths": {
      "@visactor/vtable": ["../vtable/src/index.ts"],
